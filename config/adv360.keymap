#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp BACKSLASH                  &kp N1     &kp N2  &kp N3   &kp N4         &kp N5  &tog 1                                                                                                    &mo 3      &kp N6  &kp N7      &kp N8       &kp N9            &kp N0     &none
&kp PIPE                       &kp Q      &kp W   &kp E    &kp R          &kp T   &none                                                                                                     &none      &kp Z   &kp U       &kp I        &kp P             &kp EQUAL  &kp MINUS
&mt LEFT_GUI DQT               &kp A      &kp S   &kp D    &kp F          &kp G   &none         &kp CAPSLOCK              &kp LG(LEFT_SHIFT)      &kp K_VOLUME_UP    &kp K_PLAY_PAUSE       &none      &kp H   &kp J       &kp K        &kp L             &kp O      &mt RIGHT_GUI COLON
&mt LEFT_ALT LS(SINGLE_QUOTE)  &kp COMMA  &kp Y   &lt 1 X  &kp C          &kp V                                           &kp K_MUTE              &kp K_VOLUME_DOWN                                    &kp B   &kp N       &kp M        &kp DOT           &kp FSLH   &mt RIGHT_ALT GRAVE
&mo 2                          &none      &none   &kp TAB  &kp AMPERSAND          &lt 3 ESCAPE  &mt LEFT_SHIFT BACKSPACE  &kp LEFT_CONTROL        &kp RCTRL          &mt RIGHT_SHIFT ENTER  &kp SPACE          &kp DOLLAR  &kp PERCENT  &kp LS(NUMBER_6)  &none      &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6    &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y     &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_EQUAL     &kp KP_MINUS
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H     &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp KP_MULTIPLY
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp HASH  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_SLASH     &none
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0            &kp SPACE   &none         &none          &none            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0    &bt BT_SEL 1      &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4  &none                                             &trans         &none             &none           &none             &none              &none                 &none
&none           &none           &none             &none         &none          &none         &bootloader                                       &bootloader    &kp GREATER_THAN  &kp LESS_THAN   &kp LEFT_BRACE    &kp RIGHT_BRACE    &none                 &none
&studio_unlock  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp RIGHT_GUI  &none         &none        &none  &none      &bt BT_CLR  &none  &stp STP_BAT   &kp LEFT          &kp DOWN_ARROW  &kp UP_ARROW      &kp RIGHT_ARROW    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&none           &none           &none             &none         &none          &none                             &none      &none                             &none             &kp ASTERISK    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON         &none
&none           &none           &none             &none         &none                        &none        &none  &none      &none       &none  &kp BACKSPACE                    &bl BL_INC      &bl BL_DEC        &none              &none                 &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
