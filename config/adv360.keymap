#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        commaslash: commaslash {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMASLASH";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SLASH>;

            tapping-term-ms = <180>;
        };

        ctrlgui: ctrlgui {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRLGUI";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_CONTROL>, <&kp RIGHT_GUI>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LA(NUMBER_4)  &kp N1     &kp N2  &kp N3   &kp N4          &kp N5  &tog 1                                                                                          &mo 3             &kp N6  &kp N7           &kp N8         &kp N9   &kp N0     &kp LA(NUMBER_1)
&kp LA(NUMBER_2)  &kp Q      &kp W   &kp E    &kp R           &kp T   &kp LA(NUMBER_1)                                                                                &kp LA(NUMBER_6)  &kp Z   &kp U            &kp I          &kp P    &kp EQUAL  &kp MINUS
&kp ESCAPE        &kp A      &kp S   &kp D    &kp F           &kp G   &kp LA(NUMBER_3)  &kp CAPSLOCK  &kp LG(LEFT_SHIFT)      &kp C_VOL_UP       &kp C_PLAY_PAUSE     &sk RIGHT_ALT     &kp H   &kp J            &kp K          &kp L    &kp O      &kp DOUBLE_QUOTES
&kp SQT           &kp COMMA  &kp Y   &kp X    &kp C           &kp V                                   &kp C_MUTE              &kp C_VOLUME_DOWN                                         &kp B   &kp N            &kp M          &kp DOT  &kp SLASH  &kp GRAVE
&mo 2             &none      &none   &kp TAB  &sk LEFT_SHIFT          &kp BACKSPACE     &sl 3         &sk LCTRL               &sk RCTRL          &mt RIGHT_GUI ENTER  &kp SPACE                 &sk RIGHT_SHIFT  &kp LG(SPACE)  &none    &none      &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6    &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y     &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_EQUAL     &kp KP_MINUS
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H     &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp KP_MULTIPLY
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp HASH  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_SLASH     &none
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0            &kp SPACE   &none         &none          &none            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none  &none      &none           &none         &none          &none      &none                                                       &trans        &kp LS(NUMBER_6)  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp BACKSLASH    &none              &none
&none  &kp Q      &kp W           &kp E         &kp R          &kp T      &bootloader                                                 &bootloader   &kp PIPE          &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp EXCL         &kp RIGHT_BRACKET  &kp UNDER
&none  &kp LCTRL  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_GUI   &kp G      &none          &none  &none      &bt BT_CLR  &none          &stp STP_BAT  &kp LEFT          &kp DOWN_ARROW   &kp UP_ARROW           &kp RIGHT_ARROW  &kp LEFT_BRACKET   &kp LESS_THAN
&none  &kp COMMA  &kp Y           &kp X         &kp LG(C)      &kp LG(V)                        &none      &none                                    &kp HASH          &kp ASTERISK     &kp SEMI               &kp COLON        &kp QUESTION       &kp GREATER_THAN
&none  &none      &none           &none         &kp AMPERSAND             &kp BACKSPACE  &none  &none      &kp DELETE  &kp LS(ENTER)  &kp SPACE                       &kp DOLLAR       &kp PERCENT            &none            &none              &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
