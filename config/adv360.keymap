#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        homerowLeft: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 37 38 39 40 41 42 43 44 45 53 54 55 56 57 58 59 68 69 70 71 72 73 74 75>;
            quick-tap-ms = <300>;
        };

        commaslash: commaslash {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMASLASH";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SLASH>;

            tapping-term-ms = <180>;
        };

        ctrlgui: ctrlgui {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRLGUI";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_CONTROL>, <&kp RIGHT_GUI>;
        };

        howerowRight: howerowRight {
            compatible = "zmk,behavior-hold-tap";
            label = "HOWEROWRIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <300>;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LA(NUMBER_4)  &kp N1     &kp N2  &kp N3                     &kp N4     &kp N5  &tog 1                                                                                          &mo 3          &kp N6  &kp N7             &kp N8  &kp N9                            &kp N0     &none
&kp LA(NUMBER_2)  &kp Q      &kp W   &kp E                      &kp R      &kp T   &kp LA(NUMBER_6)                                                                                &kp LA(N7)     &kp Z   &kp U              &kp I   &kp P                             &kp EQUAL  &kp RIGHT_ALT
&kp ESCAPE        &kp A      &kp S   &kp D                      &kp F      &kp G   &kp LA(NUMBER_1)  &kp CAPSLOCK  &kp LG(LEFT_SHIFT)      &kp C_VOL_UP       &kp C_PLAY_PAUSE     &kp LG(SPACE)  &kp H   &kp J              &kp K   &kp L                             &kp O      &sl 1
&kp SEMICOLON     &kp COMMA  &kp Y   &homerowLeft LEFT_SHIFT X  &kp C      &kp V                                   &kp C_MUTE              &kp C_VOLUME_DOWN                                      &kp B   &kp N              &kp M   &howerowRight RIGHT_SHIFT PERIOD  &kp SLASH  &kp GRAVE
&mo 2             &none      &none   &kp TAB                    &kp MINUS          &kp BACKSPACE     &sl 3         &sk LCTRL               &sk RCTRL          &mt RIGHT_GUI ENTER  &kp SPACE              &kp DOUBLE_QUOTES  &none   &none                             &none      &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL       &kp N1      &kp N2        &kp N3        &kp N4        &kp N5       &trans                                                        &mo 3      &kp N6    &kp KP_NUM     &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB         &kp Q       &kp N7        &kp N8        &kp N9        &kp T        &none                                                         &none      &kp Z     &kp COMMA      &kp PERIOD    &kp KP_N9      &kp KP_EQUAL     &kp KP_MINUS
&kp UNDERSCORE  &kp DOLLAR  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PERCENT  &none          &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H     &kp J          &kp K         &kp L          &kp PERIOD       &kp UNDERSCORE
&kp LSHFT       &kp COMMA   &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp V                                  &kp HOME      &kp PG_UP                        &kp HASH  &kp AMPERSAND  &kp KP_N2     &kp PERIOD     &kp KP_SLASH     &none
&mo 2           &kp GRAVE   &kp CAPS      &kp LEFT      &kp ESCAPE                 &kp BACKSPACE  &kp N0     &kp END       &kp PG_DN  &kp ENTER  &kp SPACE            &kp SPACE      &none         &none          &none            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none  &none      &none           &none         &none             &none        &none                                                           &trans        &kp LS(NUMBER_6)  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp BACKSLASH    &none             &none
&none  &kp Q      &kp W           &kp E         &kp R             &kp T        &bootloader                                                     &bootloader   &kp PIPE          &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp EXCL         &kp LESS_THAN     &kp GREATER_THAN
&none  &kp LCTRL  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp AT_SIGN  &none          &none      &none      &bt BT_CLR  &none          &stp STP_BAT  &kp LEFT          &kp DOWN_ARROW   &kp UP_ARROW           &kp RIGHT_ARROW  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&none  &kp COMMA  &kp Y           &kp LG(X)     &kp LG(C)         &kp LG(V)                              &none      &none                                    &kp HASH          &kp ASTERISK     &kp SQT                &kp COLON        &kp QUESTION      &kp TILDE
&none  &none      &none           &none         &none                          &kp BACKSPACE  &kp SLASH  &none      &kp DELETE  &kp LS(ENTER)  &kp SPACE                       &kp TAB          &none                  &none            &none             &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
