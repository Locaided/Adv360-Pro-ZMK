#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        commaslash: commaslash {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMASLASH";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SLASH>;

            tapping-term-ms = <180>;
        };
    };

    combos {
        compatible = "zmk,combos";

        fd-delete {
            bindings = <&kp BACKSPACE>;
            key-positions = <32 31>;
        };

        jk-delete {
            bindings = <&kp BACKSPACE>;
            key-positions = <40 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp BACKSLASH              &kp N1         &kp N2  &kp N3   &kp N4         &kp N5  &tog 1                                                                                                    &mo 3      &kp N6  &kp N7      &kp N8       &kp N9   &kp N0       &none
&kp PIPE                   &kp Q          &kp W   &kp E    &kp R          &kp T   &none                                                                                                     &none      &kp Z   &kp U       &kp I        &kp P    &kp EQUAL    &kp MINUS
&mt LEFT_GUI DQT           &kp A          &kp S   &kp D    &kp F          &kp G   &none         &kp CAPSLOCK              &kp LG(LEFT_SHIFT)      &kp C_VOL_UP       &kp C_PLAY_PAUSE       &none      &kp H   &kp J       &kp K        &kp L    &kp O        &mt RIGHT_GUI COLON
&mt LEFT_ALT SINGLE_QUOTE  &kp BACKSPACE  &kp Y   &lt 1 X  &kp C          &kp V                                           &kp C_MUTE              &kp C_VOLUME_DOWN                                    &kp B   &kp N       &kp M        &kp DOT  &commaslash  &mt RIGHT_ALT GRAVE
&mo 2                      &none          &none   &kp TAB  &kp AMPERSAND          &lt 3 ESCAPE  &mt LEFT_SHIFT BACKSPACE  &kp LEFT_CONTROL        &kp RCTRL          &mt RIGHT_SHIFT ENTER  &kp SPACE          &kp DOLLAR  &kp PERCENT  &none    &none        &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6    &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y     &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_EQUAL     &kp KP_MINUS
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H     &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp KP_MULTIPLY
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp HASH  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_SLASH     &none
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0            &kp SPACE   &none         &none          &none            &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0    &bt BT_SEL 1       &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4       &none                                                     &trans        &none      &none           &none            &none             &none                 &none
&none           &none           &kp LG(W)          &none         &none          &none              &bootloader                                               &bootloader   &none      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp LS(MINUS)
&studio_unlock  &kp LEFT_SHIFT  &kp LEFT_CONTROL   &kp LEFT_ALT  &kp RIGHT_GUI  &kp LG(BACKSPACE)  &none        &none  &none      &bt BT_CLR  &none          &stp STP_BAT  &kp LEFT   &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&none           &none           &kp LA(BACKSPACE)  &kp LG(X)     &kp LG(C)      &kp LG(V)                              &none      &none                                    &kp TILDE  &kp ASTERISK    &kp SEMI         &kp LS(EQUAL)     &kp LS(SLASH)         &kp LS(NUMBER_6)
&none           &none           &none              &none         &none                             &none        &none  &none      &kp DELETE  &kp BACKSPACE  &kp SPACE                &kp HASH        &kp EXCLAMATION  &none             &none                 &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
